# Run from this repository with lmscript test.lms or lmctl test.lms.
fn step(command) {
  result = system(command, {timeoutMs:900000});
  print(result.stdout); print(result.stderr);
  assert(result.code == 0, "failed: " + json_stringify(command));
}
step(["bash", "scripts/sync-std.sh", "--verify"]);
step(["dotnet", "build", "-c", "Release", "-warnaserror"]);
set_env("LMCODE_COMPILER_EXPLICIT_STD", "1");
step(["dotnet", "test", "-c", "Release", "--no-build"]);
step(["dotnet", "run", "-c", "Release", "--project", "conformance/LmCode.Conformance", "--", "conformance/vectors"]);
step(["dotnet", "run", "-c", "Release", "--project", "conformance/LmCode.Conformance", "--", "conformance/stdlib-vectors"]);
step(["bash", "scripts/compile-example.sh"]);
step(["dotnet", "run", "-c", "Release", "--project", "examples/RuleEntries", "--", "artifacts/rule-entries.dslb"]);
if (env("RUN_NATIVE") == "1") {
  rid = env("RUNTIME_ID"); assert(rid != "", "RUNTIME_ID is required");
  ext = ""; if (env("RUNNER_OS") == "Windows") { ext = ".exe"; }
  projects = [{project:"examples/Greeter", name:"Greeter"}, {project:"conformance/LmCode.Conformance", name:"LmCode.Conformance"}, {project:"examples/RuleEntries", name:"RuleEntries"}, {project:"tests/LmCode.Tests", name:"LmCode.Tests"}];
  for (p in projects) {
    step(["dotnet", "publish", p.project, "-c", "Release", "-r", rid, "--self-contained", "true", "-p:PublishAot=true", "-p:IlcTreatWarningsAsErrors=true", "-p:StripSymbols=true", "-o", "artifacts/" + p.name]);
  }
  step([path_join(Directory, "artifacts/Greeter/Greeter" + ext), "--dsl", "examples/Greeter/hello.dslb"]);
  step([path_join(Directory, "artifacts/LmCode.Conformance/LmCode.Conformance" + ext), "conformance/vectors"]);
  step([path_join(Directory, "artifacts/LmCode.Conformance/LmCode.Conformance" + ext), "conformance/stdlib-vectors"]);
  step([path_join(Directory, "artifacts/LmCode.Tests/LmCode.Tests" + ext), "--string-catalog"]);
  step([path_join(Directory, "artifacts/RuleEntries/RuleEntries" + ext), "artifacts/rule-entries.dslb"]);
}
