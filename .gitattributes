* text=auto eol=lf
# Precompiled vectors bind to the exact schema bytes, including line endings.
conformance/vectors/*.json text eol=lf
conformance/stdlib-vectors/*.json text eol=lf
*.dslb binary

# These fixture bytes are SHA-256 bound to the committed bytecode.
tests/LmCode.Tests/Fixtures/*.json text eol=lf

conformance/stdlib-vectors/*.dsl text eol=lf
conformance/stdlib-vectors/*.expect text eol=lf

# Canonical standard bytes and their digest must survive Windows checkout.
std/*.json text eol=lf
std/std.lock text eol=lf

# The REST suite is SHA-256 pinned (rest-suite.lock) and bound to the host schema bytes: never convert line endings.
conformance/rest-suite/** -text
rest-suite.lock text eol=lf
